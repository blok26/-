# Firebase Web App Configuration (Realtime Database & Anonymous Auth)
# احصل على هذه القيم من إعدادات مشروعك في Firebase Console (Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-app-id-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Server WebRTC TURN Server (اختياري - لضمان اتصال الصوت عند وجود جدران حماية أو شبكات هاتف محمول معقدة NAT)
TURN_URL="turn:turn.example.com:3478"
TURN_USERNAME="turnuser"
TURN_CREDENTIAL="turnpassword"

# Server Port
PORT=3000
APP_URL="MY_APP_URL"
